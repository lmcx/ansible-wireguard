# {{ ansible_managed }}
# {{ wg_if_name }}
# {{ wg_if }}

[connection]
id={{ wg_if_name }}
uuid={{ wg_if_name | to_uuid }}
type=wireguard
interface-name={{ wg_if_name }}

[wireguard]
{% if "fwmark" in wg_if %}
fwmark={{ wg_if.fwmark }}
{% endif %}
listen-port={{ wg_if.port }}
{% if "mtu" in wg_if %}
mtu={{ wg_if.mtu }}
{% endif %}
private-key={{ wg_if.private_key }}
{% for host in ansible_play_hosts %}
{%   if host != inventory_hostname %}
{%     if "wg_config" in hostvars[host] and wg_if_name in hostvars[host]["wg_config"] %}
{%       set host_wg_config = hostvars[host]["wg_config"][wg_if_name] %}

[wireguard-peer.{{ host_wg_config["public_key"] }}]
{# TODO: Handle "dc", empty "endpoint", ... #}
endpoint={{ host_wg_config["endpoint"] }}:{{ host_wg_config["port"] }}
{# {%       if "psk" in host_wg_config and host_wg_config["psk"] != false and host_wg_config["psk"] != "" %} #}
{# preshared-key= #}{# Pre Shared Key #}
{# preshared-key-flags=0 #}
{# {%         endif %} #}{# TODO #}
{%       if "persistent_keepalive" in host_wg_config %}
persistent-keepalive={{ host_wg_config["persistent_keepalive"] }}
{%       endif %}
{%       if "allowed_ips" in host_wg_config %}
allowed-ips={{ host_wg_config["allowed_ips"] }};
{%       endif %}
{%     endif %}
{%   endif %}
{% endfor %}

# {{ wg_if }}
{% if "unmanaged_peers" in wg_if %}
#
# Unmanaged Peers
#
{%   for peer in wg_if["unmanaged_peers"] %}
{%     set peer_config = wg_if["unmanaged_peers"][peer] %}

# {{ peer }}
[wireguard-peer.{{ peer_config["pubkey"] }}]
{% if "endpoint" in peer_config and "port" in peer_config %}
endpoint={{ peer_config["endpoint"] }}:{{ peer_config["port"] }}
{% endif %}
{% if "allowed_ips" in peer_config %}
allowed-ips={{ peer_config["allowed_ips"] | join("; ") }};
{% endif %}
{% if "persistent_keepalive" in peer_config %}
persistent-keepalive={{ peer_config["persistent_keepalive"] }}
{% endif %}
{% if "psk" in peer_config and peer_config["psk"] != false and peer_config["psk"] != "" %}
preshared-key={{ peer_config["psk"] }}
{%   if "psk_flag" in peer_config %}
preshared-key-flags={{ peer_config["psk_flag"] }}
{%   else %}
preshared-key-flags=0
{%   endif %}
{% endif %}

{%   endfor %}
{% endif %}

[ipv4]
address1={{ wg_if.address }}
{% if "dns" in wg_if %}
dns={{ wg_if.dns }};
dns-search=~;
{% endif %}
method=manual
{% if "table" in wg_if %}
route-table={{ wg_if.table }}
{% endif %}

[ipv6]
addr-gen-mode=stable-privacy
method=disabled
{% if "table" in wg_if %}
route-table={{ wg_if.table }}
{% endif %}

[proxy]